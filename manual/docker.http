### create driver
POST http://localhost:5000/api/delivery/drivers
Content-Type: application/json

{
  "firstName": "John",
  "lastName": "Doe",
  "phoneNumber": "+48123456784"
}

> {%
    client.global.set("driverId", response.body.id);
%}

### create driver
POST http://localhost:5000/api/delivery/drivers
Content-Type: application/json

{
  "firstName": "Anna",
  "lastName": "Haris",
  "phoneNumber": "+48134456784"
}

> {%
    client.global.set("driverId", response.body.id);
%}

### get drivers
GET http://localhost:5000/api/delivery/drivers

> {%
    client.global.set("driverId", response.body[0].id);
%}


### create delivery
POST http://localhost:5000/api/delivery/deliveries
Content-Type: application/json
Idempotency-Key: {{$random.uuid}}

{
  "deliveryAddress": "Test A",
  "distanceKm": 50.0,
  "pickupAddress": "Test B"
}

> {%
    client.global.set("deliveryId", response.body.id);
%}

### confirm delivery
POST http://localhost:5000/api/delivery/deliveries/{{deliveryId}}/confirm
Content-Type: application/json


### cancel delivery
POST http://localhost:5000/api/delivery/deliveries/{{deliveryId}}/cancel
Content-Type: application/json

### get deliveries
GET http://localhost:5000/api/delivery/deliveries

### get payments
GET http://localhost:5000/api/payment/payments

### get payments
GET http://localhost:5000/api/payment/payments?status=Pending

> {%
    client.global.set("paymentId", response.body[0].id);
%}

### accept/paid payments
PUT http://localhost:5000/api/payment/payments/{{paymentId}}/accept

### decline payments
PUT http://localhost:5000/api/payment/{{paymentId}}/decline

### pickup delivery
POST http://localhost:5000/api/delivery/deliveries/{{deliveryId}}/pickup
Content-Type: application/json

### start delivery
POST http://localhost:5000/api/delivery/deliveries/{{deliveryId}}/start
Content-Type: application/json

### complete delivery
POST http://localhost:5000/api/delivery/deliveries/{{deliveryId}}/complete
Content-Type: application/json

### get ledger entries
GET http://localhost:5000/api/ledger/ledger-entires

### get ledger transations
http://localhost:5000/api/ledger/ledger-transactions

### get deliveries status duration
GET http://localhost:5000/api/delivery/deliveries/status-durations?deliveryId={{deliveryId}}