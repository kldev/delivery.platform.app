# syntax=docker/dockerfile:1
FROM eclipse-temurin:25-jdk AS build
WORKDIR /workspace

# Generated by gradle-closure.sh --docker :services:notification-service:notification-web - regenerate after adding a project or project(...).
COPY gradlew settings.gradle.kts build.gradle.kts gradle.properties ./
COPY gradle gradle
# Gradle 9 refuses to configure an included project without a directory; these are outside the closure.
RUN mkdir -p services/delivery-service/delivery-domain services/delivery-service/delivery-web services/ledger-service/ledger-domain services/ledger-service/ledger-web services/reconciliation-service/reconciliation-domain services/reconciliation-service/reconciliation-web services/settlement-service/settlement-domain services/settlement-service/settlement-web
COPY libraries/common libraries/common
COPY services/notification-service/notification-domain services/notification-service/notification-domain
COPY services/notification-service/notification-web services/notification-service/notification-web

RUN --mount=type=cache,target=/root/.gradle \
    ./gradlew :services:notification-service:notification-web:quarkusBuild --no-daemon

FROM eclipse-temurin:25-jre AS runtime

# HEALTHCHECK below calls curl, and the temurin image does not ship it.
RUN apt-get update \
    && apt-get install -y --no-install-recommends curl \
    && rm -rf /var/lib/apt/lists/* \
    && groupadd --system --gid 10001 app \
    && useradd --system --uid 10001 --gid app --no-create-home app

WORKDIR /app
ARG APP=/workspace/services/notification-service/notification-web/build/quarkus-app
# Four layers, so a code change does not re-ship the libraries.
COPY --from=build --chown=10001:10001 ${APP}/lib/ ./lib/
COPY --from=build --chown=10001:10001 ${APP}/*.jar ./
COPY --from=build --chown=10001:10001 ${APP}/app/ ./app/
COPY --from=build --chown=10001:10001 ${APP}/quarkus/ ./quarkus/

USER 10001:10001
EXPOSE 8080
ENV QUARKUS_HTTP_HOST=0.0.0.0

HEALTHCHECK --interval=15s --timeout=5s --start-period=20s --retries=5 \
    CMD curl -fsS http://localhost:${PORT:-8005}/q/health/ready || exit 1

ENTRYPOINT ["java", "-XX:MaxRAMPercentage=75.0", "-XX:+ExitOnOutOfMemoryError", \
    "-Djava.util.logging.manager=org.jboss.logmanager.LogManager", "-jar", "quarkus-run.jar"]
