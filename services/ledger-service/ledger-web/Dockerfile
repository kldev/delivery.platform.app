# syntax=docker/dockerfile:1
FROM eclipse-temurin:25-jdk AS build
WORKDIR /workspace

# Generated by gradle-closure.sh --docker :services:ledger-service:ledger-web - regenerate after adding a project or project(...).
COPY gradlew settings.gradle.kts build.gradle.kts gradle.properties ./
COPY gradle gradle
# Gradle 9 refuses to configure an included project without a directory; these are outside the closure.
RUN mkdir -p services/delivery-service/delivery-domain services/delivery-service/delivery-web services/notification-service/notification-domain services/notification-service/notification-web services/reconciliation-service/reconciliation-domain services/reconciliation-service/reconciliation-web services/settlement-service/settlement-domain services/settlement-service/settlement-web
COPY libraries/common libraries/common
COPY services/ledger-service/ledger-domain services/ledger-service/ledger-domain
COPY services/ledger-service/ledger-web services/ledger-service/ledger-web

RUN --mount=type=cache,target=/root/.gradle \
    ./gradlew :services:ledger-service:ledger-web:bootJar --no-daemon

# Layers: dependencies change rarely, the application on every commit.
RUN java -Djarmode=tools -jar services/ledger-service/ledger-web/build/libs/app.jar \
    extract --layers --destination /extracted

FROM eclipse-temurin:25-jre AS runtime

# HEALTHCHECK below calls curl, and the temurin image does not ship it.
RUN apt-get update \
    && apt-get install -y --no-install-recommends curl \
    && rm -rf /var/lib/apt/lists/* \
    && groupadd --system --gid 10001 app \
    && useradd --system --uid 10001 --gid app --no-create-home app

WORKDIR /app
COPY --from=build --chown=10001:10001 /extracted/dependencies/ ./
COPY --from=build --chown=10001:10001 /extracted/spring-boot-loader/ ./
COPY --from=build --chown=10001:10001 /extracted/snapshot-dependencies/ ./
COPY --from=build --chown=10001:10001 /extracted/application/ ./

USER 10001:10001
EXPOSE 8080

HEALTHCHECK --interval=15s --timeout=5s --start-period=40s --retries=5 \
    CMD curl -fsS http://localhost:${PORT:-8082}/actuator/health/readiness || exit 1

ENTRYPOINT ["java", "-XX:MaxRAMPercentage=75.0", "-XX:+ExitOnOutOfMemoryError", "-jar", "app.jar"]
