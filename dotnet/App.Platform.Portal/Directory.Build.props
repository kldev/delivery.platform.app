<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <!-- Noise for a Blazor front of this size: LoggerMessage delegates, ConfigureAwait, culture overloads,
         "make types internal" (Blazor components and xUnit want public types), underscores in test names. -->
    <NoWarn>$(NoWarn);CA1707;CA1848;CA1873;CA2007;CA1515;CA1305;CA1307;CA1309;CA1310;CA1311;CA1304;CA1812;CA1852;CA1002;CA1819;CA1056;CA1054;CA1055;CA1031;CA1822;CA1863;CA2227;CA1062;CA1303</NoWarn>
  </PropertyGroup>
</Project>
