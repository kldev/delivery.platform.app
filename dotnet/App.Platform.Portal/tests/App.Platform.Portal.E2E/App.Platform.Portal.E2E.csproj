<Project Sdk="Microsoft.NET.Sdk">
  <!-- The running portal (docker compose: portal on 5080, gateway on 5000) in a real browser (Playwright, Chromium).
       Nothing is mocked: every click goes through the gateway to the services and through Kafka between them. -->
  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <OutputType>Exe</OutputType>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="Shouldly" />
    <PackageReference Include="Microsoft.Playwright" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="Xunit" />
    <Using Include="Shouldly" />
    <Using Include="Microsoft.Playwright" />
    <Using Static="true" Include="Microsoft.Playwright.Assertions" />
  </ItemGroup>
  <ItemGroup>
    <!-- One stack for every test: run them one after another so the lists stay predictable. -->
    <Content Include="xunit.runner.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
