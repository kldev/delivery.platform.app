<Project Sdk="Microsoft.NET.Sdk.Web">
  <!-- The platform's operations portal: Blazor (Interactive Server), calls the services through the gateway with the
       clients Kiota generates (App.Platform.Portal.ApiClients). -->
  <PropertyGroup>
    <RootNamespace>App.Platform.Portal</RootNamespace>
    <BlazorDisableThrowNavigationException>true</BlazorDisableThrowNavigationException>
    <!-- The SDK infers this from .razor items, which do not exist when the Dockerfile restores from the .csproj alone:
         the framework assets package (blazor.web.js) would then be missing from the image. -->
    <RequiresAspNetWebAssets>true</RequiresAspNetWebAssets>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../App.Platform.Portal.ApiClients/App.Platform.Portal.ApiClients.csproj" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="App.Platform.Portal.Tests" />
  </ItemGroup>
</Project>
