@page "/deliveries/new"
@using App.Platform.Portal.ApiClients.Delivery
@using App.Platform.Portal.ApiClients.Delivery.Models
@inject DeliveryApi Deliveries
@inject Toasts Toasts
@inject NavigationManager Navigation

<PageTitle>Nowa dostawa - Platform</PageTitle>

<div class="page" style="max-width: 820px">
    <PageHeader Title="Nowa dostawa" BackHref="deliveries" BackText="Dostawy"
                Lead="Serwis dostaw policzy cenę z dystansu. Zlecenie startuje jako nowe - potwierdzisz je na następnym ekranie." />

    <section class="panel">
        <form class="panel-body" @onsubmit="Submit" novalidate>
            <div class="form-grid">
                <div class="field wide">
                    <label for="pickup">Adres odbioru</label>
                    <input id="pickup" class="@Invalid("pickupAddress")" @bind="_pickup" maxlength="500" autocomplete="off" placeholder="np. Kraków, ul. Floriańska 3" />
                    <FieldError Message="@_failure?.Field("pickupAddress")" />
                </div>
                <div class="field wide">
                    <label for="dropoff">Adres doręczenia</label>
                    <input id="dropoff" class="@Invalid("deliveryAddress")" @bind="_dropoff" maxlength="500" autocomplete="off" placeholder="np. Kraków, ul. Długa 10" />
                    <FieldError Message="@_failure?.Field("deliveryAddress")" />
                </div>
                <div class="field">
                    <label for="distance">Dystans (km)</label>
                    <input id="distance" type="number" step="0.1" min="0.1" class="@Invalid("distanceKm")" @bind="_distance" />
                    <FieldError Message="@_failure?.Field("distanceKm")" />
                </div>
                <div class="field">
                    <label for="currency">Waluta</label>
                    <select id="currency" @bind="_currency">
                        <option value="PLN">PLN - złoty</option>
                        <option value="EUR">EUR - euro</option>
                    </select>
                    <span class="help">Cenę w tej walucie zobaczysz po zapisaniu.</span>
                </div>
            </div>

            @if (_failure is not null && _failure.Fields.Count == 0)
            {
                <div class="notice" role="alert" style="margin-top: 18px">
                    <Icon Name="alert" />
                    <div class="notice-text">@_failure.Message</div>
                </div>
            }

            <div class="form-actions" style="margin-top: 22px">
                <a class="btn" href="deliveries">Anuluj</a>
                <button type="submit" class="btn btn-primary" disabled="@_saving">
                    <Icon Name="@(_saving ? "loader" : "check")" Class="@(_saving ? "spin" : null)" />
                    @(_saving ? "Zapisuję..." : "Utwórz zlecenie")
                </button>
            </div>
        </form>
    </section>
</div>

@code {
    // One key per opened form: a second click or a retry after a lost answer creates the delivery once (the service
    // answers the same request with the same key from its idempotency record).
    private readonly Guid _idempotencyKey = Guid.NewGuid();

    private string? _pickup;
    private string? _dropoff;
    private double? _distance;
    private string _currency = "PLN";
    private bool _saving;
    private ApiFailure? _failure;

    private string? Invalid(string field) => _failure?.Field(field) is null ? null : "invalid";

    private async Task Submit()
    {
        _failure = Validate();
        if (_failure is not null)
            return;

        _saving = true;
        try
        {
            var created = await Deliveries.Api.Delivery.Deliveries.PostAsync(
                new CreateDeliveryRequest
                {
                    PickupAddress = _pickup!.Trim(),
                    DeliveryAddress = _dropoff!.Trim(),
                    DistanceKm = _distance,
                    Currency = _currency,
                },
                c => c.Headers.Add("Idempotency-Key", _idempotencyKey.ToString())
            );
            Toasts.Success("Zlecenie utworzone", $"Cena: {Format.Money(created?.Price, created?.Currency)}");
            Navigation.NavigateTo($"deliveries/{created?.Id}");
        }
        catch (Exception ex)
        {
            _failure = ApiErrors.Describe(ex);
        }
        finally
        {
            _saving = false;
        }
    }

    private ApiFailure? Validate()
    {
        var fields = new Dictionary<string, string>();
        if (string.IsNullOrWhiteSpace(_pickup))
            fields["pickupAddress"] = "Podaj adres odbioru.";
        if (string.IsNullOrWhiteSpace(_dropoff))
            fields["deliveryAddress"] = "Podaj adres doręczenia.";
        if (_distance is null or < 0.1)
            fields["distanceKm"] = "Dystans to co najmniej 0,1 km.";
        return fields.Count == 0 ? null : new ApiFailure("Popraw zaznaczone pola.", fields);
    }
}
