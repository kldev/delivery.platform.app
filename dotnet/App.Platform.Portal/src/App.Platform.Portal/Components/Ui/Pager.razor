@* The services return slices (content + hasNext), not totals: the pager knows only "is there a next page". *@
<div class="pager">
    <span>Strona @(Page + 1)@(ItemCount > 0 ? $", pozycji na stronie: {ItemCount}" : "")</span>
    <div class="pager-buttons">
        <button type="button" class="btn btn-sm" disabled="@(Page == 0 || Busy)" @onclick="() => PageChanged.InvokeAsync(Page - 1)">
            <Icon Name="chevron-left" />Poprzednia
        </button>
        <button type="button" class="btn btn-sm" disabled="@(!HasNext || Busy)" @onclick="() => PageChanged.InvokeAsync(Page + 1)">
            Następna<Icon Name="chevron-right" />
        </button>
    </div>
</div>

@code {
    [Parameter]
    public int Page { get; set; }

    [Parameter]
    public bool HasNext { get; set; }

    [Parameter]
    public int ItemCount { get; set; }

    [Parameter]
    public bool Busy { get; set; }

    [Parameter]
    public EventCallback<int> PageChanged { get; set; }
}
