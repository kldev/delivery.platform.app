{
  "openapi": "3.1.1",
  "info": {
    "title": "Delivery payment API (via Gateway)",
    "version": "1.0.0"
  },
  "paths": {
    "/api/payment/payments/{id}/{action}": {
      "put": {
        "tags": [
          "Delivery.Platform.PaymentService"
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "action",
            "in": "path",
            "required": true,
            "schema": {
              "$ref": "#/components/schemas/PaymentAction"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/payment/payments": {
      "get": {
        "tags": [
          "Delivery.Platform.PaymentService"
        ],
        "parameters": [
          {
            "name": "status",
            "in": "query",
            "schema": {
              "$ref": "#/components/schemas/PaymentStatus"
            }
          },
          {
            "name": "deliveryId",
            "in": "query",
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/PaymentItemResponse"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/payment/payments/external": {
      "get": {
        "tags": [
          "Delivery.Platform.PaymentService"
        ],
        "parameters": [
          {
            "name": "paymentId",
            "in": "query",
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "deliveryId",
            "in": "query",
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "transactionId",
            "in": "query",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/ExternalTransactionItemResponse"
                  }
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "Delivery.Platform.PaymentService"
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateExternalCommand"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Resource"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "CreateExternalCommand": {
        "required": [
          "paymentId",
          "transactionId",
          "amount",
          "provider"
        ],
        "type": "object",
        "properties": {
          "paymentId": {
            "type": "string",
            "format": "uuid"
          },
          "transactionId": {
            "type": "string"
          },
          "amount": {
            "type": "number",
            "format": "double"
          },
          "provider": {
            "type": "string"
          }
        }
      },
      "ExternalTransactionItemResponse": {
        "required": [
          "id",
          "paymentId",
          "deliveryId",
          "externalTransactionId",
          "provider",
          "paymentAmount",
          "amount",
          "currency",
          "createdAt"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "paymentId": {
            "type": "string",
            "format": "uuid"
          },
          "deliveryId": {
            "type": "string",
            "format": "uuid"
          },
          "externalTransactionId": {
            "type": "string"
          },
          "provider": {
            "type": "string"
          },
          "paymentAmount": {
            "type": "number",
            "format": "double"
          },
          "amount": {
            "type": "number",
            "format": "double"
          },
          "currency": {
            "type": "string"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "PaymentAction": {
        "enum": [
          "accept",
          "decline"
        ]
      },
      "PaymentItemResponse": {
        "required": [
          "id",
          "deliveryId",
          "amount",
          "currency",
          "status",
          "createdAt",
          "paidAt"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "deliveryId": {
            "type": "string",
            "format": "uuid"
          },
          "amount": {
            "type": "number",
            "format": "double"
          },
          "currency": {
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "paidAt": {
            "type": [
              "null",
              "string"
            ],
            "format": "date-time"
          }
        }
      },
      "PaymentStatus": {
        "enum": [
          "Pending",
          "Paid",
          "Failed",
          null
        ]
      },
      "Resource": {
        "required": [
          "id"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          }
        }
      }
    }
  },
  "tags": [
    {
      "name": "Delivery.Platform.PaymentService"
    }
  ]
}
