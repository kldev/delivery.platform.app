{
  "openapi": "3.1.0",
  "info": {
    "title": "Delivery reconciliation API (via Gateway)",
    "version": "v0"
  },
  "paths": {
    "/api/reconciliation/reconciliations": {
      "get": {
        "tags": [
          "Reconciliations"
        ],
        "summary": "List reconciliations",
        "description": "Newest first. Filter by status=DISCREPANCY to see deliveries whose payment does not match the settlement.",
        "operationId": "listReconciliations",
        "parameters": [
          {
            "name": "status",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "PENDING",
                "RECONCILED",
                "DISCREPANCY",
                "MISSING_PAYMENT",
                "MISSING_SETTLEMENT"
              ]
            }
          },
          {
            "name": "deliveryId",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "settlementId",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "paymentId",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "externalTransactionId",
            "in": "query",
            "description": "Exact id of the transfer at the payment provider",
            "required": false,
            "schema": {
              "type": "string",
              "maxLength": 255,
              "minLength": 0
            }
          },
          {
            "name": "page",
            "in": "query",
            "description": "Zero-based page number",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int32",
              "default": 0,
              "minimum": 0
            }
          },
          {
            "name": "size",
            "in": "query",
            "description": "Page size, 1 to 500",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int32",
              "default": 100,
              "maximum": 500,
              "minimum": 1
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SliceResponseReconciliationResponse"
                }
              }
            }
          },
          "400": {
            "description": "Validation failed (`validation`, with `errors[]`)",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetail"
                }
              }
            }
          },
          "500": {
            "description": "Unexpected error (`internal-error`)",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetail"
                }
              }
            }
          }
        }
      }
    },
    "/api/reconciliation/reconciliations/{reconciliationId}": {
      "get": {
        "tags": [
          "Reconciliations"
        ],
        "summary": "Get a reconciliation",
        "operationId": "getReconciliation",
        "parameters": [
          {
            "name": "reconciliationId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReconciliationResponse"
                }
              }
            }
          },
          "400": {
            "description": "Validation failed (`validation`, with `errors[]`)",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetail"
                }
              }
            }
          },
          "404": {
            "description": "Not found (`*.not-found`)",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetail"
                }
              }
            }
          },
          "500": {
            "description": "Unexpected error (`internal-error`)",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetail"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ReconciliationResponse": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "deliveryId": {
            "type": "string",
            "format": "uuid"
          },
          "settlementId": {
            "type": [
              "string",
              "null"
            ],
            "format": "uuid"
          },
          "paymentId": {
            "type": [
              "string",
              "null"
            ],
            "format": "uuid"
          },
          "externalTransactionId": {
            "type": [
              "string",
              "null"
            ]
          },
          "expectedAmount": {
            "type": [
              "number",
              "null"
            ],
            "description": "What the driver should receive, from the settlement; null until it arrives"
          },
          "actualAmount": {
            "type": [
              "number",
              "null"
            ],
            "description": "What the payment transferred; null until it arrives"
          },
          "difference": {
            "type": [
              "number",
              "null"
            ],
            "description": "actualAmount - expectedAmount, once both are known"
          },
          "currency": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "PENDING",
              "RECONCILED",
              "DISCREPANCY",
              "MISSING_PAYMENT",
              "MISSING_SETTLEMENT"
            ]
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "reconciledAt": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          }
        }
      },
      "SliceResponseReconciliationResponse": {
        "type": "object",
        "properties": {
          "content": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ReconciliationResponse"
            }
          },
          "hasNext": {
            "type": "boolean"
          }
        }
      },
      "ProblemDetail": {
        "properties": {
          "type": {
            "type": "string",
            "format": "uri"
          },
          "title": {
            "type": "string"
          },
          "status": {
            "type": "integer",
            "format": "int32"
          },
          "detail": {
            "type": "string"
          },
          "instance": {
            "type": "string",
            "format": "uri"
          },
          "code": {
            "type": "string",
            "description": "Stable, machine-readable reason, e.g. delivery.not-found"
          },
          "errors": {
            "type": "array",
            "description": "Invalid fields of the request",
            "items": {
              "type": "object",
              "properties": {
                "field": {
                  "type": "string"
                },
                "message": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    }
  }
}
