{
  "openapi": "3.1.0",
  "info": {
    "title": "Delivery delivery API (via Gateway)",
    "version": "v0"
  },
  "paths": {
    "/api/delivery/drivers": {
      "get": {
        "tags": [
          "Drivers"
        ],
        "summary": "List drivers",
        "operationId": "listDrivers",
        "parameters": [
          {
            "name": "driverId",
            "in": "query",
            "description": "Only this driver (kept for existing clients; prefer GET /api/drivers/{driverId})",
            "required": false,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/DriverResponse"
                  }
                }
              }
            }
          },
          "400": {
            "description": "Validation failed (`validation`, with `errors[]`) or malformed request",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetail"
                }
              }
            }
          },
          "429": {
            "description": "Rate limit exceeded (`rate-limited`), see Retry-After",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetail"
                }
              }
            }
          },
          "500": {
            "description": "Unexpected error (`internal-error`)",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetail"
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "Drivers"
        ],
        "summary": "Create a driver",
        "description": "Registers an active driver. Phone number and email must be unique\n(409 `driver.phone-number-taken` / `driver.email-taken`).",
        "operationId": "createDriver",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateDriverRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Created; Location points to the driver",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DriverResponse"
                }
              }
            }
          },
          "400": {
            "description": "Validation failed (`validation`, with `errors[]`) or malformed request",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetail"
                }
              }
            }
          },
          "409": {
            "description": "Phone number or email taken (`driver.phone-number-taken`, `driver.email-taken`)",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetail"
                }
              }
            }
          },
          "500": {
            "description": "Unexpected error (`internal-error`)",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetail"
                }
              }
            }
          }
        }
      }
    },
    "/api/delivery/deliveries": {
      "get": {
        "tags": [
          "Deliveries"
        ],
        "summary": "List deliveries",
        "description": "Newest first. Returned as a slice: `hasNext` says whether another page exists,\nwithout counting all rows.",
        "operationId": "listDeliveries",
        "parameters": [
          {
            "name": "status",
            "in": "query",
            "description": "Only deliveries in this status",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "CREATED",
                "CONFIRMED",
                "ASSIGNED",
                "PICKED_UP",
                "IN_TRANSIT",
                "DELIVERED",
                "CANCELLED"
              ]
            }
          },
          {
            "name": "deliveryId",
            "in": "query",
            "description": "Only this delivery",
            "required": false,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "driverId",
            "in": "query",
            "description": "Only deliveries of this driver",
            "required": false,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "page",
            "in": "query",
            "description": "Zero-based page number",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int32",
              "default": 0,
              "minimum": 0
            }
          },
          {
            "name": "size",
            "in": "query",
            "description": "Page size, 1 to 500",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int32",
              "default": 100,
              "maximum": 500,
              "minimum": 1
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SliceResponseDeliveryResponse"
                }
              }
            }
          },
          "400": {
            "description": "Validation failed (`validation`, with `errors[]`) or malformed request",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetail"
                }
              }
            }
          },
          "429": {
            "description": "Rate limit exceeded (`rate-limited`), see Retry-After",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetail"
                }
              }
            }
          },
          "500": {
            "description": "Unexpected error (`internal-error`)",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetail"
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "Deliveries"
        ],
        "summary": "Create a delivery",
        "description": "Creates a delivery in status CREATED and prices it by distance.\n\nRequires the Idempotency-Key header (UUID). Repeating the request with the same key and body returns the\nfirst response (with header Idempotent-Replayed: true) without creating another delivery. The same key with a\ndifferent body is rejected with 422 `idempotency.key-reused`; while the first request is still running, 409\n`idempotency.in-progress`. A request that failed can be retried with the same key.",
        "operationId": "createDelivery",
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "description": "Unique key of this request (UUID)",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateDeliveryRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Created; Location points to the delivery",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CreateDeliveryResponse"
                }
              }
            }
          },
          "400": {
            "description": "Validation failed, or Idempotency-Key missing/invalid (`idempotency.key-missing`, `idempotency.key-invalid`)",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetail"
                }
              }
            }
          },
          "409": {
            "description": "A request with this Idempotency-Key is in progress (`idempotency.in-progress`)",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetail"
                }
              }
            }
          },
          "422": {
            "description": "Idempotency-Key used with a different body (`idempotency.key-reused`)",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetail"
                }
              }
            }
          },
          "500": {
            "description": "Unexpected error (`internal-error`)",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetail"
                }
              }
            }
          }
        }
      }
    },
