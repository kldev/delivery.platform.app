{
  "openapi": "3.1.0",
  "info": {
    "title": "Delivery settlement API (via Gateway)",
    "version": "v0"
  },
  "paths": {
    "/api/settlement/settlements": {
      "get": {
        "tags": [
          "Settlements"
        ],
        "summary": "List settlements",
        "description": "Newest first.",
        "operationId": "listSettlements",
        "parameters": [
          {
            "name": "search",
            "in": "query",
            "description": "Part of the driver's name, case-insensitive",
            "required": false,
            "schema": {
              "type": "string",
              "maxLength": 200,
              "minLength": 0
            }
          },
          {
            "name": "driverId",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "deliveryId",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "page",
            "in": "query",
            "description": "Zero-based page number",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int32",
              "default": 0,
              "minimum": 0
            }
          },
          {
            "name": "size",
            "in": "query",
            "description": "Page size, 1 to 500",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int32",
              "default": 100,
              "maximum": 500,
              "minimum": 1
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SliceResponseSettlementResponse"
                }
              }
            }
          },
          "400": {
            "description": "Validation failed (`validation`, with `errors[]`)",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetail"
                }
              }
            }
          },
          "500": {
            "description": "Unexpected error (`internal-error`)",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetail"
                }
              }
            }
          }
        }
      }
    },
    "/api/settlement/settlements/{settlementId}": {
      "get": {
        "tags": [
          "Settlements"
        ],
        "summary": "Get a settlement",
        "operationId": "getSettlement",
        "parameters": [
          {
            "name": "settlementId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SettlementResponse"
                }
              }
            }
          },
          "400": {
            "description": "Validation failed (`validation`, with `errors[]`)",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetail"
                }
              }
            }
          },
          "404": {
            "description": "Not found (`*.not-found`)",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetail"
                }
              }
            }
          },
          "500": {
            "description": "Unexpected error (`internal-error`)",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetail"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "SettlementResponse": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "deliveryId": {
            "type": "string",
            "format": "uuid"
          },
          "driverId": {
            "type": "string",
            "format": "uuid"
          },
          "driverFullName": {
            "type": "string"
          },
          "deliveryAmount": {
            "type": "number"
          },
          "currency": {
            "type": "string"
          },
          "basePercentage": {
            "type": "number"
          },
          "nightPercentage": {
            "type": "number"
          },
          "weekendPercentage": {
            "type": "number"
          },
          "distancePercentage": {
            "type": "number"
          },
          "totalPercentage": {
            "type": "number"
          },
          "driverAmount": {
            "type": "number"
          },
          "distanceKm": {
            "type": "number"
          },
          "completedAt": {
            "type": "string",
            "format": "date-time"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "SliceResponseSettlementResponse": {
        "type": "object",
        "properties": {
          "content": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/SettlementResponse"
            }
          },
          "hasNext": {
            "type": "boolean"
          }
        }
      },
      "ProblemDetail": {
        "properties": {
          "type": {
            "type": "string",
            "format": "uri"
          },
          "title": {
            "type": "string"
          },
          "status": {
            "type": "integer",
            "format": "int32"
          },
          "detail": {
            "type": "string"
          },
          "instance": {
            "type": "string",
            "format": "uri"
          },
          "code": {
            "type": "string",
            "description": "Stable, machine-readable reason, e.g. delivery.not-found"
          },
          "errors": {
            "type": "array",
            "description": "Invalid fields of the request",
            "items": {
              "type": "object",
              "properties": {
                "field": {
                  "type": "string"
                },
                "message": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    }
  }
}
